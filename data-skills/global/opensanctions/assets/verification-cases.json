      "operation": "search-entities",
      "input": {"q": "\"Wagner Group\"", "schema": "Organization", "dataset": "default", "limit": 2, "offset": 0, "filter_op": "AND"},
      "expect": {"statuses": ["ok", "auth_required"], "min_records": 0, "required_fields": ["id", "entity", "caption", "datasets", "source_url"]}
    },
    {
      "id": "get-known-entity",
      "operation": "get-entity",
